# Primary origin. https://aussietools.au redirects to www and is rewritten to www if set here.
NEXT_PUBLIC_SITE_URL=https://www.aussietools.au
# Enable after reviewing the privacy notice and Vercel account setup.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
# Optional endpoint accepting POST { problem: string }; leave unset for local-only suggestions.
NEXT_PUBLIC_FEEDBACK_ENDPOINT=

